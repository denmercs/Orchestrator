{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "index.client.tsx",
    "index.server.ts",
    "client/**/*.tsx",
    "client/**/*.ts",
    "server/**/*.ts",
    "shared/**/*.ts"
  ]
}
